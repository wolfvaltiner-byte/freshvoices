<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow page-hero__eyebrow" data-de="Sprechen Sie mich an" data-en="Let's talk">Sprechen Sie mich an</p>
      <h1 class="display-lg text-white" data-de="Kontakt" data-en="Contact">Kontakt</h1>
      <p class="mt-16" data-de="Kein langer Prozess. Schreiben Sie mir — ich antworte innerhalb von 24 Stunden." data-en="No long process. Write to me — I'll reply within 24 hours.">
        Kein langer Prozess. Schreiben Sie mir — ich antworte innerhalb von 24 Stunden.
      </p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="contact-layout">

        <!-- Left: Contact info -->
        <div class="contact-info reveal">
          <div class="contact-info__item">
            <div class="contact-info__label" data-de="Telefon" data-en="Phone">Telefon</div>
            <div class="contact-info__value"><a href="tel:+4366488473943">+43 664 884 73943</a></div>
          </div>
          <div class="contact-info__item">
            <div class="contact-info__label">E-Mail</div>
            <div class="contact-info__value">
              <!-- Email obfuscated from scrapers via data attribute -->
              <a href="mailto:wolf.valtiner@freshvoices.at">wolf.valtiner@freshvoices.at</a>
            </div>
          </div>
          <div class="contact-info__item">
            <div class="contact-info__label" data-de="Standort" data-en="Location">Standort</div>
            <div class="contact-info__value" data-de="Wien, Österreich" data-en="Vienna, Austria">Wien, Österreich</div>
          </div>
          <div class="contact-info__item">
            <div class="contact-info__label" data-de="Social" data-en="Social">Social</div>
            <div class="contact-info__value flex gap-16">
              <a href="https://fb.me/Fresh.Voices.Vienna" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" opacity="0.6"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
              <a href="https://www.linkedin.com/in/wolfvaltiner" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" opacity="0.6"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
            </div>
          </div>

          <div class="contact-promise">
            <div class="contact-promise__head" data-de="Mein Versprechen" data-en="My promise">Mein Versprechen</div>
            <div class="contact-promise__text" data-de="Ich antworte auf jede ernsthafte Anfrage innerhalb von 24 Stunden. Wenn Sie ein Skript schicken, bitte ich gerne einen kostenlosen Probe-Take an." data-en="I reply to every serious enquiry within 24 hours. If you send a script, I'm happy to record a free demo take.">
              Ich antworte auf jede ernsthafte Anfrage innerhalb von 24 Stunden. Wenn Sie ein Skript schicken, bitte ich gerne einen kostenlosen Probe-Take an.
            </div>
          </div>
        </div>

        <!-- Right: Contact form -->
        <div class="contact-form-col reveal">
          <form id="contactForm" name="contact" action="/api/contact" method="POST" novalidate>

            <div class="grid-2-gap-20">
              <div class="form-group">
                <label for="firstName" data-de="Vorname" data-en="First name">Vorname</label>
                <input type="text" id="firstName" name="firstName" autocomplete="given-name" required minlength="2" />
                <span class="form-error" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="lastName" data-de="Nachname" data-en="Last name">Nachname</label>
                <input type="text" id="lastName" name="lastName" autocomplete="family-name" required minlength="2" />
                <span class="form-error" aria-live="polite"></span>
              </div>
            </div>

            <div class="form-group">
              <label for="email">E-Mail</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
              <span class="form-error" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="company" data-de="Unternehmen / Agentur (optional)" data-en="Company / Agency (optional)">Unternehmen / Agentur (optional)</label>
              <input type="text" id="company" name="company" autocomplete="organization" />
            </div>

            <div class="form-group">
              <label for="projectType" data-de="Projektart" data-en="Project type">Projektart</label>
              <select id="projectType" name="projectType" required>
                <option value="" data-de="Bitte wählen..." data-en="Please select...">Bitte wählen...</option>
                <option value="corporate" data-de="Corporate / Imagefilm" data-en="Corporate / Image film">Corporate / Imagefilm</option>
                <option value="documentary" data-de="Dokumentation" data-en="Documentary">Dokumentation</option>
                <option value="elearning" data-de="E-Learning / Training" data-en="E-Learning / Training">E-Learning / Training</option>
                <option value="commercial" data-de="Werbung / Spot" data-en="Commercial / Spot">Werbung / Spot</option>
                <option value="audiobook" data-de="Hörbuch" data-en="Audiobook">Hörbuch</option>
                <option value="ivr" data-de="IVR / Telefonansage" data-en="IVR / Phone message">IVR / Telefonansage</option>
                <option value="other" data-de="Sonstiges" data-en="Other">Sonstiges</option>
              </select>
              <span class="form-error" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="message" data-de="Nachricht / Projektbeschreibung" data-en="Message / Project description">Nachricht / Projektbeschreibung</label>
              <textarea id="message" name="message" required minlength="10"
                placeholder="Beschreiben Sie Ihr Projekt kurz. Textlänge, Liefertermin, Tonalität — je mehr Sie mir geben, desto schneller kann ich antworten."></textarea>
              <span class="form-error" aria-live="polite"></span>
            </div>

            <!-- Honeypot anti-spam -->
            <p class="form-hidden" aria-hidden="true">
              <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <!--
              Cloudflare Turnstile widget. The site key below is Turnstile's
              published "always passes" test key (1x00000000000000000000AA) —
              replace it in src/_data/site.json (turnstileSiteKey) with the
              real site key from the Cloudflare dashboard before go-live.
              See docs/review-2026-09/CUTOVER-eleventy.md.
            -->
            <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-theme="dark" data-appearance="interaction-only"></div>

            <button type="submit" class="btn btn--primary w-full justify-center"
                    data-de="Anfrage senden" data-en="Send enquiry">Anfrage senden</button>

            <div id="formFeedback" class="form-feedback" role="status" aria-live="polite"></div>

            <p class="mt-16 text-muted text-sm-center"
               data-de="Keine Weitergabe Ihrer Daten. Antwort innerhalb von 24 Stunden." data-en="No data shared. Reply within 24 hours.">
              Keine Weitergabe Ihrer Daten. Antwort innerhalb von 24 Stunden.
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>
