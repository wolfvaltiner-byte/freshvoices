<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
{%- if keywords %}
  <meta name="keywords" content="{{ keywords }}" />
{%- endif %}
{%- if robots %}
  <meta name="robots" content="{{ robots }}" />
{%- endif %}
  <link rel="canonical" href="{{ canonical }}" />
{% if ogTitle %}
  <!-- Open Graph -->
  <meta property="og:title" content="{{ ogTitle }}" />
  <meta property="og:description" content="{{ ogDescription }}" />
  <meta property="og:url" content="{{ canonical }}" />
  <meta property="og:type" content="website" />
{% endif %}
  <meta property="og:image" content="https://www.freshvoices.at/images/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://www.freshvoices.at/images/og-image.png" />
  <!-- Fonts -->
  <link rel="icon" type="image/svg+xml" href="images/favicons/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="images/favicons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="images/favicons/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="images/favicons/favicon-192x192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="images/favicons/apple-touch-icon.png" />
  <link rel="shortcut icon" href="favicon.ico" />
  <link rel="manifest" href="site.webmanifest" />
  <meta name="theme-color" content="#1A1A1A" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="css/style.css" />
{% if pageCss %}
  <link rel="stylesheet" href="{{ pageCss }}" />
{% endif %}
  <link rel="stylesheet" href="css/utilities.css" />
{% if preloadHero %}
  <link rel="preload" as="image" href="images/hero-poster.jpg" fetchpriority="high" />
{% endif %}
</head>
<body>

  <a href="#main" class="skip-link">Skip to content</a>

{% include "nav.njk" %}

  <main id="main">

{{ content | safe }}

  </main>

{% include "footer.njk" %}

  <script src="js/main.js"></script>
{% if pageJs %}
  <script src="{{ pageJs }}"></script>
{% endif %}

</body>
</html>
